# ──────────────────────────────────────────────────────────────────────────────
# FlashCards backend — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────


# ── Logging ───────────────────────────────────────────────────────────────────

# Python log level for the backend.
# Accepted values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
LOG_LEVEL=INFO


# ── Ollama ────────────────────────────────────────────────────────────────────

# Base URL of your local Ollama instance.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model used for flashcard text generation.
OLLAMA_MODEL=llama3.2

# Model used for image-based flashcard generation (must support vision).
# Pull with: ollama pull llava
OLLAMA_VISION_MODEL=llava


# ── Session security ──────────────────────────────────────────────────────────

# Number of days before an inactive session token is rejected.
# Default: 30
SESSION_MAX_AGE_DAYS=30


# ── Database ──────────────────────────────────────────────────────────────────

# SQLite DB path relative to the backend package directory.
# Override to use a different path in production.
# DATABASE_URL=sqlite:///./flashcards.db


# ── Rate limiting ─────────────────────────────────────────────────────────────

# Maximum number of /generate calls allowed per user per hour (in-memory).
# Default: 20
# GENERATE_RATE_LIMIT=20
